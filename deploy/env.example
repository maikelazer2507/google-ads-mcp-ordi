# Copy this file outside the repository, fill it in and source it. It contains
# identifiers only. Never put secret values here or commit a filled-in copy.

export GCP_PROJECT_ID="your-google-cloud-project"
export GCP_REGION="europe-west3"
export ARTIFACT_REPOSITORY="mcp-servers"
export CLOUD_RUN_SERVICE="google-ads-mcp"
export DEPLOYMENT_ENVIRONMENT="production"
export RUNTIME_SERVICE_ACCOUNT="google-ads-mcp-runtime@your-google-cloud-project.iam.gserviceaccount.com"
export SECRET_PREFIX="google-ads-mcp-prod"
export DEVELOPER_TOKEN_SECRET_VERSION="1"
export OAUTH_CLIENT_ID_SECRET_VERSION="1"
export OAUTH_CLIENT_SECRET_SECRET_VERSION="1"
export JWT_SIGNING_KEY_SECRET_VERSION="1"
export STORAGE_ENCRYPTION_KEY_SECRET_VERSION="1"
export APPROVAL_GOOGLE_CLIENT_ID_SECRET_VERSION="1"
export APPROVAL_SESSION_KEY_SECRET_VERSION="1"
export CHANGESET_INTEGRITY_KEY_SECRET_VERSION="1"

# Production releases must use digest references, never mutable tags.
export PYTHON_IMAGE="python:3.11.13-slim-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST"
export UV_IMAGE="ghcr.io/astral-sh/uv:0.11.33@sha256:REPLACE_WITH_VERIFIED_DIGEST"
export IMAGE_DIGEST_URI="europe-west3-docker.pkg.dev/your-google-cloud-project/mcp-servers/google-ads-mcp@sha256:REPLACE_AFTER_BUILD"

export RELEASE_ID="git-sha-or-release-id"
export CANARY_TAG="canary-git-sha"

# Non-secret deployment restrictions. Replace these examples only in the
# external environment file; do not publish real account IDs or domains.
export GOOGLE_ADS_LOGIN_CUSTOMER_ID="1111111111"
export GOOGLE_ADS_READ_CUSTOMER_IDS="2222222222"
export GOOGLE_ADS_ALLOWED_CUSTOMER_IDS="2222222222"
export GOOGLE_ADS_ALLOWED_FINAL_URL_HOSTS="www.example.com,example.com"
export GOOGLE_ADS_OPERATOR_EMAILS="maria@example.com,maikel@example.com"
export GOOGLE_ADS_APPROVER_EMAILS="maikel@example.com"
export MCP_BASE_URL="https://google-ads-mcp-REPLACE.a.run.app"
export APPROVAL_BASE_URL="https://google-ads-mcp-REPLACE.a.run.app"
export MCP_ALLOWED_CLIENT_REDIRECT_URIS="https://chatgpt.com/REPLACE_WITH_EXACT_CALLBACK"

# Required only for rollback. Obtain it from `deploy/cloud-run.sh status`.
export ROLLBACK_REVISION=""
